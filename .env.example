# ===========================================
# ADK Agent Hub - Environment Variables
# ===========================================
# Copy this file to .env and fill in your keys

# Google Gemini API Key (Required for Google ADK & Gemini models)
GOOGLE_API_KEY=your_google_api_key_here

# Tavily API Key for web search tool (Required for news/web search)
TAVILY_API_KEY=your_tavily_api_key_here

# PostgreSQL Configuration
POSTGRES_USER=adk_user
POSTGRES_PASSWORD=adk_password_change_me
POSTGRES_DB=adk_agent_hub
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://adk_user:adk_password_change_me@postgres:5432/adk_agent_hub

# MCP Server
MCP_SERVER_HOST=mcp-server
MCP_SERVER_PORT=8003
MCP_SERVER_URL=http://mcp-server:8003

# Router Service
ROUTER_HOST=router
ROUTER_PORT=8000
ROUTER_URL=http://router:8000

# Agent Builder Service
AGENT_BUILDER_HOST=agent-builder
AGENT_BUILDER_PORT=8002
AGENT_BUILDER_URL=http://agent-builder:8002

# ChromaDB & Vector Store
CHROMA_PERSIST_DIR=/data/chromadb
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Model Configuration
GEMINI_MODEL=gemini-3.6-flash
